# Generated by lab/contract.tf for this lab's resource names. Do not edit;
# change contracts/examples/billing-agent.fns.yaml and the template instead.
version: 2
contract: billing-agent-blast-radius
assume_compromised: sp:${agent}

must_not_reach:
  - resource: ${vault}
    operations: [secrets/get, secrets/list]
  - directory: tenant
    operations: [roleAssignments/write, applications/credentials/update]
  - resource: ${payroll}
    operations: [listKeys, blob/read]
  - resource: ${invoices}
    operations: [listKeys]
  - application: ${verifier}
    operations: [credentials/update, owners/update]
  - application: ${scout}
    operations: [credentials/update, owners/update]

must_still_do:
  - resource: ${invoices}
    operations: [blob/read, blob/write]
    source: declared

budget:
  max_critical_reachable: 0
  max_inconclusive: 3
  # Approved 2026-11-27: only these three may stay inconclusive. Any other
  # inconclusive item is over budget, whatever the count.
  accepted_inconclusive:
    - target: resource:${invoices}
      operation: blob/write
      reason: writes stay rung 2 by design; prove never makes a write
    - target: directory:tenant
      operation: applications/credentials/update
      reason: one app's denial isn't tenant-wide
    - target: directory:tenant
      operation: roleAssignments/write
      reason: SD3, no direct attempt; a strike never counts for it
on_inconclusive: fail
