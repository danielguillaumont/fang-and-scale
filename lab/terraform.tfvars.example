# Copy to terraform.tfvars (gitignored) and fill in your DEDICATED lab tenant.
# Never point this at a production tenant.
tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "eastus"
prefix          = "fns"

# Optional: allow GitHub Actions (main branch of this repo) to sign in as the
# scout identity via OIDC. Leave empty to disable.
github_repository = ""
