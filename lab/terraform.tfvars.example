# Copy to terraform.tfvars (gitignored) and fill in your DEDICATED lab tenant.
# Never point this at a production tenant.
tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000"
# Required. Pick a region your subscription allows (Azure for Students, for
# example, restricts regions by policy). List them with:
#   az policy assignment list --query "[].{name:displayName, allowed:parameters.listOfAllowedLocations.value}"
location        = "<allowed-region>"
prefix          = "fns"

# Optional: allow GitHub Actions (main branch of this repo) to sign in as the
# scout identity via OIDC. Leave empty to disable.
github_repository = ""

# Optional: set false to test the scout without Directory.Read.All.
# scout_directory_read_all = false

# Optional (M4 D7): a monthly cost alert on the lab subscription. Leave empty on
# Azure for Students, which Cost Management does not support (lab/README.md).
# budget_alert_email = "you@example.invalid"
# budget_amount      = 10
