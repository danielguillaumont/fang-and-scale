# Generated by lab/scope.tf. Do not edit or commit (contains real lab tenant IDs).
version: 1
tenant_id: ${tenant_id}
subscription_ids:
  - ${subscription_id}
allowed_resource_groups:
  - ${resource_group}
test_identities:
  - object_id: ${agent_object_id}
    kind: servicePrincipal
    name: sp-billing-agent
    app_id: ${agent_app_id}
allowed_operations:
  scout:
%{ for op in operations ~}
    - ${op}
%{ endfor ~}
%{ if enable_strikes ~}
%{ for op in strike_scout_operations ~}
    - ${op}
%{ endfor ~}
%{ endif ~}
  prove:
%{ for op in prove_operations ~}
    - ${op}
%{ endfor ~}
%{ if enable_strikes ~}
  strike:
%{ for op in strike_operations ~}
    - ${op}
%{ endfor ~}
%{ endif ~}
data_objects:
%{ for obj in data_objects ~}
  - resource: ${obj.resource}
    operation: ${obj.operation}
%{ endfor ~}
budget:
  max_api_calls: 500
  max_minutes: 15
expires_at: "${expires_at}"
%{ if enable_strikes ~}
strike:
  expires_at: "${strike_expires_at}"
  targets:
%{ for id in strike_arm_targets ~}
    - kind: arm
      id: ${id}
%{ endfor ~}
%{ for app in strike_app_targets ~}
    - kind: graph-application
      id: ${app.id}
      display_name: ${app.display_name}
%{ endfor ~}
    - kind: graph-service-principal
      id: ${strike_escalation.service_principal}
      display_name: ${strike_escalation.display_name}
      application: ${strike_escalation.application}
  escalation:
    service_principal: ${strike_escalation.service_principal}
    marker_role_id: ${strike_escalation.marker_role_id}
%{ endif ~}
