{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./lab/*.tfstate)",
      "Read(./lab/*.tfstate.*)",
      "Read(./lab/terraform.tfvars)",
      "Bash(terraform destroy*)",
      "Bash(az role assignment create*)",
      "Bash(az ad app credential*)"
    ],
    "ask": [
      "Bash(terraform apply*)",
      "Bash(git push*)",
      "Bash(gh repo*)"
    ]
  }
}
